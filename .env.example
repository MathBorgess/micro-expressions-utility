# Copie para .env: cp .env.example .env
# Todas as variáveis usam o prefixo APP_

# --- Pipeline ---
# false = dublês determinísticos (CI/dev rápido, sem GPU)
# true  = MediaPipe + Whisper + Ollama reais (requer --extra ml, ffmpeg, Ollama)
APP_USE_REAL_PIPELINE=false

APP_WHISPER_MODEL=base
APP_OLLAMA_URL=http://localhost:11434
APP_MAX_CONTEXT_TOKENS=7500

# --- Banco e arquivos ---
APP_DATABASE_URL=sqlite:///./data/app.db
# APP_UPLOAD_DIR e APP_JOB_WORK_DIR usam defaults: data/uploads e data/jobs

# --- Auth (dev) ---
APP_AUTH_USERNAME=vendedor
APP_AUTH_PASSWORD=changeme
APP_AUTH_SECRET=dev-secret-change-me

# --- CORS (frontend Next.js) ---
# APP_CORS_ORIGINS=["http://localhost:3000"]
